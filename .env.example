# Optional AI enrichment. Trip generation still works without it.
VITE_GOOGLE_GEMINI_AI_API_KEY=your_gemini_api_key
VITE_GEMINI_MODEL=gemini-1.5-flash

# Optional live events. Keep this secret; it is used by the server/API layer.
PREDICTHQ_ACCESS_TOKEN=your_predicthq_access_token

# Optional Google Maps JavaScript key. TripSphere core features do not depend on it.
VITE_GOOGLE_PLACE_API_KEY=your_google_maps_key
